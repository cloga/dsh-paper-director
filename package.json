{
  "name": "dsh-paper-director",
  "version": "0.1.0",
  "description": "纸上小导演 — storyboard photos and one complete recording into a child-authored movie, with persistent DSH tools and a dedicated Web studio.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tools": "./src/tools.js",
    "./core": "./src/core/service.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "src/**/*.js", "lib/client.js", "web/*.html", "web/*.js", "web/*.css", "python/worker.py", "python/paper_director/*.py", "python/README.md", "presets/**/*.yml", "cordis.patch.yml", "requirements.txt", "requirements-asr.txt", "README.md", "LICENSE", "docs/*.md", "scripts/install-preset.mjs", "scripts/check-package.mjs"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar"], "external": ["react"] }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests/python -v",
    "check": "node scripts/check-package.mjs",
    "verify": "npm test && npm run check",
    "demo": "node scripts/demo.mjs",
    "install:preset": "node scripts/install-preset.mjs"
  },
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "react": ">=18.3.1 <20"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "react": "19.2.8"
  },
  "repository": { "type": "git", "url": "https://github.com/cloga/dsh-paper-director.git" },
  "homepage": "https://github.com/cloga/dsh-paper-director#readme",
  "bugs": { "url": "https://github.com/cloga/dsh-paper-director/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "storyboard", "paper-cut", "video", "education"]
}
